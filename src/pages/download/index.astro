---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HashVerifier from '../../components/HashVerifier.astro';
import TerminalBlock from '../../components/TerminalBlock.astro';
import { RELEASE_CONFIG } from '../../config/release';

const hasAndroidUrl = Boolean(RELEASE_CONFIG.ANDROID.ANDROID_APK_URL);
---

<BaseLayout
  title={`Download Pouse v${RELEASE_CONFIG.VERSION} — Windows & Android`}
  description="Download official Pouse v1.0.0 desktop installer for Windows 10/11 and the companion Android APK. Verify SHA-256 integrity."
>
  <div class="download-page">
    <div class="container download-container">
      <!-- Page Header -->
      <div class="download-header">
        <span class="badge badge-brand">Official Releases</span>
        <h1 class="page-title">Download Pouse</h1>
        <p class="page-subtitle">
          Direct downloads for Windows 10/11 desktop clients and Android companion devices.
        </p>
      </div>

      <!-- Main Download Cards Grid -->
      <div class="download-cards-grid stagger-group">
        <!-- Windows Card (Primary) -->
        <div class="platform-card card card-elevated download-card-sweep reveal" id="windows">
          <div class="card-top">
            <div class="platform-badge-row">
              <span class="badge badge-windows">Windows Primary</span>
              <span class="badge badge-brand">v{RELEASE_CONFIG.VERSION}</span>
            </div>
            <h2 class="platform-name">Windows 10 / 11</h2>
            <p class="platform-desc lead-text">
              Lightweight desktop client written in Rust. Manages local connections, handles pairing credentials, and relays input to the OS.
            </p>
          </div>

          <div class="package-specs">
            <div class="spec-row">
              <span class="spec-label">File</span>
              <code class="spec-val">{RELEASE_CONFIG.WINDOWS.FILENAME}</code>
            </div>
            <div class="spec-row">
              <span class="spec-label">Size</span>
              <span class="spec-val">{RELEASE_CONFIG.WINDOWS.SIZE_FORMATTED} ({RELEASE_CONFIG.WINDOWS.SIZE_BYTES.toLocaleString()} bytes)</span>
            </div>
            <div class="spec-row">
              <span class="spec-label">Architecture</span>
              <span class="spec-val">x64 (64-bit)</span>
            </div>
            <div class="spec-row">
              <span class="spec-label">Install Location</span>
              <span class="spec-val">Per-user (<code>AppData\Local\Programs\Pouse</code>)</span>
            </div>
            <div class="spec-row">
              <span class="spec-label">Host</span>
              <span class="spec-val">Hosted on GitHub Releases</span>
            </div>
          </div>

          <div class="platform-action">
            <a href={RELEASE_CONFIG.WINDOWS.DOWNLOAD_URL} class="btn btn-primary btn-lg btn-block">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
              <span>Download Installer (.exe)</span>
            </a>
            <div class="card-sublinks">
              <a href="/download/windows" class="sublink animated-link">Detailed Windows setup guide →</a>
            </div>
          </div>
        </div>

        <!-- Android Card (Secondary) -->
        <div class="platform-card card download-card-sweep reveal" id="android">
          <div class="card-top">
            <div class="platform-badge-row">
              <span class="badge badge-android">Android Mobile</span>
              <span class="badge badge-outline">Direct APK</span>
            </div>
            <h2 class="platform-name">Android Companion</h2>
            <p class="platform-desc lead-text">
              Mobile application built with Flutter and Kotlin. Transmits multi-touch, motion, hand tracking, and remote screen touch events.
            </p>
          </div>

          <div class="package-specs">
            <div class="spec-row">
              <span class="spec-label">Package Name</span>
              <code class="spec-val">{RELEASE_CONFIG.ANDROID.APP_ID}</code>
            </div>
            <div class="spec-row">
              <span class="spec-label">File</span>
              <code class="spec-val">{RELEASE_CONFIG.ANDROID.FILENAME}</code>
            </div>
            <div class="spec-row">
              <span class="spec-label">Distribution</span>
              <span class="spec-val">Direct APK download</span>
            </div>
            <div class="spec-row">
              <span class="spec-label">Store Status</span>
              <span class="spec-val">Not on Google Play</span>
            </div>
          </div>

          <div class="platform-action">
            {hasAndroidUrl ? (
              <a href={RELEASE_CONFIG.ANDROID.ANDROID_APK_URL} class="btn btn-secondary btn-lg btn-block">
                Download Android APK
              </a>
            ) : (
              <button type="button" class="btn btn-secondary btn-lg btn-block btn-disabled" aria-disabled="true">
                Coming soon / link pending
              </button>
            )}
            <div class="card-sublinks">
              <a href="/download/android" class="sublink">Android sideload & permissions guide →</a>
            </div>
          </div>

          <div class="sideload-hint">
            <strong>Note on APK installation:</strong> Because this is a direct APK download outside the Google Play Store, Android browsers and Play Protect may prompt a confirmation before installing.
          </div>
        </div>
      </div>

      <!-- Windows SmartScreen Calm Notice -->
      <div class="smartscreen-card card">
        <div class="smartscreen-header">
          <div class="smartscreen-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
          </div>
          <h3 class="smartscreen-title">Windows SmartScreen Notice</h3>
        </div>
        <div class="smartscreen-body">
          <p>
            The Pouse Windows installer is newly released and not code-signed yet. When launching the installer, Windows SmartScreen may display a prompt stating <em>"Windows protected your PC"</em>.
          </p>
          <div class="smartscreen-steps">
            <strong>How to proceed safely:</strong>
            <ol>
              <li>Verify the downloaded file's SHA-256 checksum against the official hash below.</li>
              <li>Ensure the installer was downloaded directly from the official GitHub release.</li>
              <li>On the SmartScreen dialog, click <strong>"More info"</strong>.</li>
              <li>Click <strong>"Run anyway"</strong> to begin setup.</li>
            </ol>
          </div>
        </div>
      </div>

      <!-- SHA-256 Hash Verification -->
      <div class="download-hash-section">
        <HashVerifier />
      </div>

      <!-- Terminal / CLI Section -->
      <div class="download-cli-section">
        <div class="cli-intro">
          <span class="badge badge-brand">Terminal Option</span>
          <h2 class="section-title">Install via Windows Terminal</h2>
          <p class="section-desc">
            If you manage your software from PowerShell or Command Prompt, use the official <code>pouse-cli</code> tool published on npm. It downloads the official installer and requires SHA-256 verification before execution.
          </p>
        </div>
        <TerminalBlock initialCommand="npm install -g pouse-cli&#10;pouse install" />
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .download-page {
    padding: 64px 0 96px;
  }

  .download-container {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .download-header {
    text-align: center;
    max-width: 640px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .page-title {
    font-size: clamp(2.2rem, 3.5vw + 1rem, 3rem);
  }

  .page-subtitle {
    font-size: 1.05rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .download-cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
  }

  @media (min-width: 840px) {
    .download-cards-grid {
      grid-template-columns: 1.15fr 1fr;
      align-items: stretch;
    }
  }

  .platform-card {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 32px;
  }

  .platform-badge-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
  }

  .platform-name {
    font-size: 1.6rem;
    margin-bottom: 8px;
  }

  .platform-desc {
    font-size: 0.94rem;
    color: var(--color-text-secondary);
    line-height: 1.55;
    margin: 0;
  }

  .package-specs {
    background-color: var(--color-bg-canvas);
    border: 1px solid var(--color-border-subtle);
    border-radius: 10px;
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 0.85rem;
  }

  .spec-row {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    flex-wrap: wrap;
  }

  .spec-label {
    color: var(--color-text-muted);
    flex-shrink: 0;
  }

  .spec-val {
    color: var(--color-text-primary);
    text-align: right;
    word-break: break-all;
    overflow-wrap: anywhere;
    max-width: 100%;
  }

  .spec-val code {
    color: var(--color-purple-light);
    font-size: 0.82rem;
    word-break: break-all;
    overflow-wrap: anywhere;
  }

  @media (max-width: 480px) {
    .spec-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 2px;
    }
    .spec-val {
      text-align: left;
    }
  }

  .platform-action {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: auto;
  }

  .btn-block {
    width: 100%;
  }

  .card-sublinks {
    text-align: center;
  }

  .sublink {
    font-size: 0.88rem;
    color: var(--color-purple-light);
    text-decoration: none;
  }

  .sublink:hover {
    text-decoration: underline;
  }

  .sideload-hint {
    background-color: var(--color-bg-canvas);
    border: 1px solid var(--color-border-subtle);
    border-radius: 8px;
    padding: 10px 14px;
    font-size: 0.82rem;
    color: var(--color-text-muted);
    line-height: 1.45;
  }

  /* SmartScreen Notice */
  .smartscreen-card {
    background-color: var(--color-bg-surface-elevated);
    border-left: 4px solid var(--color-status-warning);
    padding: 24px 28px;
  }

  .smartscreen-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }

  .smartscreen-icon {
    color: var(--color-status-warning);
    display: flex;
  }

  .smartscreen-title {
    font-size: 1.15rem;
    margin: 0;
  }

  .smartscreen-body p {
    font-size: 0.92rem;
    color: var(--color-text-secondary);
    line-height: 1.55;
    margin-bottom: 14px;
  }

  .smartscreen-steps {
    font-size: 0.9rem;
    color: var(--color-text-primary);
    background-color: var(--color-bg-canvas);
    border: 1px solid var(--color-border-subtle);
    border-radius: 8px;
    padding: 14px 18px;
  }

  .smartscreen-steps ol {
    margin-top: 8px;
    margin-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    color: var(--color-text-secondary);
  }

  .download-cli-section {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-top: 16px;
  }

  .cli-intro {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
</style>
