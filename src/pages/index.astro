<script is:inline>
  (function() {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // 1. Hero Pointer Tilt (Desktop Only)
    if (window.matchMedia('(hover: hover) and (pointer: fine)').matches && !prefersReduced) {
      const heroStage = document.querySelector('.hero-stage');
      const phoneTilt = document.getElementById('heroPhoneTilt');
      if (heroStage && phoneTilt) {
        let targetX = 0, targetY = 0, currentX = 0, currentY = 0, reqId = null;

        function updateTilt() {
          currentX += (targetX - currentX) * 0.12;
          currentY += (targetY - currentY) * 0.12;
          phoneTilt.style.transform = 'perspective(900px) rotateX(' + currentX.toFixed(2) + 'deg) rotateY(' + currentY.toFixed(2) + 'deg)';
          if (Math.abs(targetX - currentX) > 0.05 || Math.abs(targetY - currentY) > 0.05) {
            reqId = requestAnimationFrame(updateTilt);
          } else {
            reqId = null;
          }
        }

        heroStage.addEventListener('pointermove', function(e) {
          const rect = heroStage.getBoundingClientRect();
          const x = (e.clientX - rect.left) / rect.width - 0.5;
          const y = (e.clientY - rect.top) / rect.height - 0.5;
          targetX = -y * 12; // max ~6-7 deg
          targetY = x * 12;
          if (!reqId) reqId = requestAnimationFrame(updateTilt);
        }, { passive: true });

        heroStage.addEventListener('pointerleave', function() {
          targetX = 0;
          targetY = 0;
          if (!reqId) reqId = requestAnimationFrame(updateTilt);
        });
      }
    }

    // 2. Scroll Storytelling Modes Crossfade (Desktop)
    if ('IntersectionObserver' in window && !prefersReduced) {
      const steps = document.querySelectorAll('.mode-story-step');
      const layers = document.querySelectorAll('.story-phone-layer');

      if (steps.length > 0 && layers.length > 0) {
        const stepObserver = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              const stepIdx = entry.target.getAttribute('data-step');
              steps.forEach(function(s) {
                if (s.getAttribute('data-step') === stepIdx) s.classList.add('is-active');
                else s.classList.remove('is-active');
              });
              layers.forEach(function(l) {
                if (l.getAttribute('data-layer') === stepIdx) l.classList.add('is-active');
                else l.classList.remove('is-active');
              });
            }
          });
        }, { threshold: 0.5, rootMargin: '-10% 0px -20% 0px' });

        steps.forEach(function(step) {
          stepObserver.observe(step);
        });
      }
    }
  })();
</script>

