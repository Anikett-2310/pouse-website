---
import BaseLayout from '../layouts/BaseLayout.astro';
import TerminalBlock from '../components/TerminalBlock.astro';
import PlaceholderSlot from '../components/PlaceholderSlot.astro';
import { RELEASE_CONFIG } from '../config/release';
---

<BaseLayout
  title="Pouse — One phone. Multiple ways to control your PC."
  description="Pouse converts an Android smartphone into a multi-mode wireless input device for Windows 10/11 PCs over local Wi-Fi or Bluetooth."
>
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="container hero-inner">
      <div class="hero-copy">
        <div class="hero-badge-group hero-enter-1">
          <span class="badge badge-brand">Release v{RELEASE_CONFIG.VERSION}</span>
          <span class="badge badge-windows">Windows 10/11</span>
          <span class="badge badge-android">Android</span>
        </div>

        <h1 class="hero-title hero-enter-1">
          One phone.<br />
          <span class="gradient-text">Multiple ways to control your PC.</span>
        </h1>

        <p class="hero-subtitle lead-text hero-enter-2">
          Pouse turns your Android phone into a wireless trackpad and controller for your Windows PC. Control mouse movement, gestures, and desktop actions over Wi-Fi or Bluetooth — no extra hardware or accounts required.
        </p>

        <div class="hero-actions hero-enter-3">
          <a href="/download" class="btn btn-primary btn-lg">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span>Download for Windows</span>
          </a>

          <a href="/modes" class="btn btn-secondary btn-lg">
            <span>Explore All 5 Modes</span>
            <span>→</span>
          </a>
        </div>

        <div class="hero-meta hero-enter-3">
          <span class="meta-item">Windows client ({RELEASE_CONFIG.WINDOWS.SIZE_FORMATTED})</span>
          <span class="meta-dot">•</span>
          <span class="meta-item">Direct Android APK</span>
          <span class="meta-dot">•</span>
          <span class="meta-item">No extra hardware needed</span>
        </div>
      </div>

      <!-- Hero Visual: "Phone controls PC" interactive demonstration -->
      <div class="hero-visual reveal hero-enter-3">
        <div class="hero-stage pause-offscreen">
          <!-- Real phone frame with pointer-reactive tilt (desktop only) -->
          <div class="hero-phone-wrap hero-phone-tilt" id="heroPhoneTilt">
            <PlaceholderSlot
              assetId="hero-phone"
              label="Live Pouse Mobile App"
              description="Real screenshot showing Touchpad Mode with speed & scroll adjustments."
              aspectRatio="9/16"
              deviceType="phone"
              lazy={false}
              fetchPriority="high"
              showCaption={false}
            />
            <!-- Touch indicator demonstrating active interaction on the phone's touchpad surface -->
            <div class="hero-phone-touch-point" aria-hidden="true">
              <div class="hero-touch-ripple"></div>
              <div class="hero-touch-core"></div>
            </div>
          </div>

          <!-- Wireless connection bridge stream -->
          <div class="hero-connection-flow" aria-hidden="true">
            <div class="connection-line-container">
              <svg class="connection-svg" viewBox="0 0 80 20" fill="none">
                <defs>
                  <linearGradient id="heroLineGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                    <stop offset="0%" stop-color="#A855F7" stop-opacity="0.3" />
                    <stop offset="50%" stop-color="#EC4899" stop-opacity="0.9" />
                    <stop offset="100%" stop-color="#38BDF8" stop-opacity="0.8" />
                  </linearGradient>
                </defs>
                <path d="M 0 10 L 80 10" stroke="rgba(168, 85, 247, 0.2)" stroke-width="2" stroke-dasharray="3 3" />
                <path d="M 0 10 L 80 10" stroke="url(#heroLineGrad)" stroke-width="2.5" stroke-linecap="round" class="connection-pulse-path" />
              </svg>
              <div class="connection-packet-node"></div>
            </div>
            <span class="connection-chip">Local Link</span>
          </div>

          <!-- Recognizable Landscape Windows PC Monitor -->
          <div class="hero-pc-wrapper" aria-hidden="true">
            <div class="hero-pc-monitor">
              <div class="hero-pc-screen">
                <!-- Windows Titlebar with Windows Logo & native controls -->
                <div class="hero-pc-header">
                  <div class="pc-win-branding">
                    <svg class="pc-win-logo" width="10" height="10" viewBox="0 0 16 16" fill="currentColor">
                      <rect x="1" y="1" width="6" height="6" fill="#38BDF8" />
                      <rect x="9" y="1" width="6" height="6" fill="#38BDF8" />
                      <rect x="1" y="9" width="6" height="6" fill="#38BDF8" />
                      <rect x="9" y="9" width="6" height="6" fill="#38BDF8" />
                    </svg>
                    <span class="pc-title-text">Windows 11 Desktop</span>
                  </div>
                  <div class="pc-win-controls">
                    <span class="win-btn win-min" title="Minimize"></span>
                    <span class="win-btn win-max" title="Maximize"></span>
                    <span class="win-btn win-close" title="Close"></span>
                  </div>
                </div>

                <!-- Windows Desktop Canvas with Wallpaper, App Target, Taskbar & Windows Pointer -->
                <div class="hero-pc-canvas">
                  <div class="pc-app-card">
                    <div class="pc-app-tab-strip">
                      <span class="pc-tab is-active">Receiver</span>
                      <span class="pc-tab">Input</span>
                    </div>
                    <div class="pc-app-content">
                      <div class="pc-target-button" id="pcTargetBtn">
                        <span class="pc-target-dot"></span>
                        <span class="pc-target-label">Pouse Click</span>
                      </div>
                      <div class="pc-card-bar"></div>
                    </div>
                  </div>

                  <!-- Windows 11 Centered Taskbar -->
                  <div class="pc-taskbar">
                    <div class="taskbar-icons">
                      <svg class="taskbar-win-icon" width="10" height="10" viewBox="0 0 16 16" fill="#38BDF8">
                        <rect x="1" y="1" width="6" height="6" />
                        <rect x="9" y="1" width="6" height="6" />
                        <rect x="1" y="9" width="6" height="6" />
                        <rect x="9" y="9" width="6" height="6" />
                      </svg>
                      <span class="taskbar-app pouse-app"></span>
                      <span class="taskbar-app generic-app"></span>
                    </div>
                    <div class="taskbar-tray">
                      <span class="tray-dot"></span>
                      <span class="tray-clock">10:24</span>
                    </div>
                  </div>

                  <!-- Windows Cursor & Click Pulse -->
                  <div class="hero-cursor-layer">
                    <svg class="hero-animated-cursor" viewBox="0 0 16 20" fill="none">
                      <path d="M1 1L6 18L9 11.5L15 11L1 1Z" fill="#FFFFFF" stroke="#07040B" stroke-width="1.2" stroke-linejoin="round" />
                    </svg>
                    <div class="hero-click-pulse"></div>
                  </div>
                </div>
              </div>

              <!-- Monitor Stand -->
              <div class="hero-pc-stand">
                <div class="pc-stand-stem"></div>
                <div class="pc-stand-foot"></div>
              </div>
            </div>

            <!-- Sleek Status Pill Anchored Directly Below Monitor -->
            <div class="hero-status-pill">
              <span class="status-live-dot" aria-hidden="true"></span>
              <span class="status-title">Pouse Protocol Active</span>
              <span class="status-sep">•</span>
              <span class="status-modes">Direct Wi-Fi / Bluetooth</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Problem Statement & Factual Stats Strip -->
  <section class="problem-section">
    <div class="container">
      <div class="problem-card card reveal">
        <div class="problem-quote-col">
          <span class="eyebrow"><span class="eyebrow-index">00</span> The Problem</span>
          <blockquote class="problem-quote pull-quote">
            "I need a mouse, but I don't have one with me."
          </blockquote>
        </div>
        <div class="problem-body-col">
          <p>
            When you need to control a Windows PC on the go, carrying dedicated peripherals isn't always practical. You always have a smartphone with you.
          </p>
          <p>
            Pouse does not claim to have invented the smartphone-as-mouse concept. Its core differentiator is uniting <strong>five distinct input technologies</strong> — multi-touch surfaces, tilt motion, computer vision hand tracking, gaming input, and remote screen streaming — behind <strong>one shared protocol and a single lightweight Windows client</strong>.
          </p>
        </div>
      </div>

      <!-- Factual Stats Grid (Strictly Documented Facts) -->
      <div class="stat-counter-grid reveal">
        <div class="stat-counter-card">
          <span class="stat-number gradient-text">5</span>
          <span class="stat-label">Input Modes</span>
        </div>
        <div class="stat-counter-card">
          <span class="stat-number">2</span>
          <span class="stat-label">Wi-Fi + Bluetooth</span>
        </div>
        <div class="stat-counter-card">
          <span class="stat-number">10/11</span>
          <span class="stat-label">Windows Supported</span>
        </div>
        <div class="stat-counter-card">
          <span class="stat-number gradient-text">0</span>
          <span class="stat-label">Accounts / Cloud</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Scroll Storytelling Modes Section -->
  <section class="modes-section" id="modes">
    <div class="container">
      <div class="section-header reveal">
        <span class="eyebrow"><span class="eyebrow-index">01</span> Input Technology</span>
        <h2 class="section-title">Five Top-Level Modes</h2>
        <p class="section-desc">
          Explore different ways to interact with your PC, adapted to your current environment and task.
        </p>
      </div>

      <div class="modes-story-container pause-offscreen">
        <!-- Scrolling Modes Story Steps -->
        <div class="modes-story-steps">
          <!-- Step 0: Touchpad -->
          <div class="mode-story-step is-active reveal" data-step="0" id="step-touchpad">
            <span class="display-bg-text" aria-hidden="true">01</span>
            <div class="step-header">
              <span class="badge badge-brand">Multi-Touch</span>
              <h3 class="step-title">Touchpad Mode</h3>
              <p class="step-tech"><code>GestureDetector (Flutter)</code></p>
            </div>

            <!-- Mobile phone image (visible on <= 899px) -->
            <div class="mode-story-phone-mobile">
              <PlaceholderSlot
                assetId="touchpad-mode"
                label="Touchpad Mode"
                description="85% gesture area + 15% scroll zone"
                aspectRatio="9/16"
                deviceType="phone"
              />
            </div>

            <p class="step-desc">
              Precision multi-touch surface featuring an 85% normal movement area and a dedicated 15% right-side scroll zone.
            </p>

            <ul class="step-inputs">
              <li>1-finger drag moves the cursor smoothly</li>
              <li>Single tap = left click; double tap = double click</li>
              <li>Two-finger tap = right click</li>
              <li>Hold and drag = drag and drop selection</li>
              <li>Two-finger swipe = vertical and horizontal scroll</li>
              <li>Pinch = system zoom and magnification</li>
            </ul>

            <!-- Micro-animation for Touchpad gestures -->
            <div class="gesture-anim-badge" aria-label="Touchpad Gesture Animation">
              <svg width="36" height="36" viewBox="0 0 64 64" fill="none" class="gesture-anim" aria-hidden="true">
                <rect x="8" y="10" width="48" height="44" rx="6" stroke="rgba(168,85,247,0.3)" stroke-width="1.5" fill="rgba(13,7,21,0.6)" />
                <circle cx="26" cy="32" r="10" stroke="var(--color-pink-accent)" stroke-width="2" class="gesture-tap-ripple" opacity="0.8" fill="none" />
                <circle cx="26" cy="32" r="3.5" fill="var(--color-purple-primary)" />
                <line x1="46" y1="14" x2="46" y2="50" stroke="rgba(236,72,153,0.3)" stroke-width="1" stroke-dasharray="2 2" />
                <g class="gesture-scroll-arrows">
                  <path d="M52 24 L55 20 L58 24" stroke="var(--color-pink-accent)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                  <path d="M52 40 L55 44 L58 40" stroke="var(--color-pink-accent)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </g>
              </svg>
              <span>Tap to click &bull; 2-finger scroll zone &bull; Pinch zoom</span>
            </div>
          </div>

          <!-- Step 1: Motion -->
          <div class="mode-story-step reveal" data-step="1" id="step-motion">
            <span class="display-bg-text" aria-hidden="true">02</span>
            <div class="step-header">
              <span class="badge badge-brand">Inertial Sensors</span>
              <h3 class="step-title">Motion Mode</h3>
              <p class="step-tech"><code>Accelerometer + Gyroscope (sensors_plus)</code></p>
            </div>

            <div class="mode-story-phone-mobile">
              <PlaceholderSlot
                assetId="motion-mode"
                label="Motion Mode"
                description="In-air gyro steering & trigger"
                aspectRatio="9/16"
                deviceType="phone"
              />
            </div>

            <p class="step-desc">
              In-air presentation and steering control. Hold down the center button on your screen and tilt or wave your phone to move the PC cursor.
            </p>

            <ul class="step-inputs">
              <li>Hold center trigger button to steer cursor</li>
              <li>Relative sensor deltas translate to pointer displacement</li>
              <li>Releasing the button releases cursor control instantly</li>
            </ul>

            <!-- Micro-animation for Motion tilt -->
            <div class="gesture-anim-badge" aria-label="Motion Gyro Animation">
              <svg width="36" height="36" viewBox="0 0 64 64" fill="none" class="gesture-anim" aria-hidden="true">
                <g class="gesture-gyro-phone">
                  <rect x="22" y="12" width="20" height="40" rx="4" stroke="var(--color-purple-primary)" stroke-width="1.5" fill="rgba(168,85,247,0.1)" />
                  <circle cx="32" cy="32" r="4" fill="var(--color-purple-light)" />
                </g>
                <path d="M46 22 L40 34 L43 35 L40 40 L43 41 L46 36 L50 36 Z" fill="var(--color-pink-accent)" class="gesture-gyro-cursor" />
              </svg>
              <span>Hold trigger button &bull; In-air gyro displacement</span>
            </div>
          </div>

          <!-- Step 2: Touchless -->
          <div class="mode-story-step reveal" data-step="2" id="step-touchless">
            <span class="display-bg-text" aria-hidden="true">03</span>
            <div class="step-header">
              <span class="badge badge-brand">Computer Vision</span>
              <h3 class="step-title">Touchless Mode</h3>
              <p class="step-tech"><code>Front Camera + On-Device MediaPipe</code></p>
            </div>

            <div class="mode-story-phone-mobile">
              <PlaceholderSlot
                assetId="touchless-mode"
                label="Touchless Mode"
                description="MediaPipe hand tracking camera"
                aspectRatio="9/16"
                deviceType="phone"
              />
            </div>

            <p class="step-desc">
              Wave your hand in front of your phone's front camera to steer the cursor without touching the screen. All machine learning inference runs locally on your phone.
            </p>

            <ul class="step-inputs">
              <li>Hand landmark detection tracks palm position</li>
              <li>Move hand across the camera view to navigate</li>
              <li>Thumb + index finger pinch triggers left click</li>
              <li>Zero cloud video streaming — 100% on-device vision</li>
            </ul>

            <!-- Micro-animation for Touchless pinch -->
            <div class="gesture-anim-badge" aria-label="Touchless Hand Pinch Animation">
              <svg width="36" height="36" viewBox="0 0 64 64" fill="none" class="gesture-anim" aria-hidden="true">
                <circle cx="32" cy="32" r="20" stroke="rgba(168,85,247,0.25)" stroke-width="1.5" stroke-dasharray="3 3" />
                <circle cx="22" cy="32" r="4.5" fill="var(--color-purple-primary)" class="gesture-pinch-left" />
                <circle cx="42" cy="32" r="4.5" fill="var(--color-pink-accent)" class="gesture-pinch-right" />
                <circle cx="32" cy="32" r="1.5" fill="#FFFFFF" opacity="0.6" />
              </svg>
              <span>Palm steering &bull; Thumb-index pinch click &bull; On-device</span>
            </div>
          </div>

          <!-- Step 3: Gaming -->
          <div class="mode-story-step reveal" data-step="3" id="step-gaming">
            <span class="display-bg-text" aria-hidden="true">04</span>
            <div class="step-header">
              <span class="badge badge-brand">Gamepad</span>
              <h3 class="step-title">Gaming Mode</h3>
              <p class="step-tech"><code>Virtual Landscape Gamepad</code></p>
            </div>

            <div class="mode-story-phone-mobile">
              <PlaceholderSlot
                assetId="gaming-mode"
                label="Gaming Mode"
                description="Virtual gamepad layout with D-pad & action buttons"
                aspectRatio="9/16"
                deviceType="phone"
              />
            </div>

            <p class="step-desc">
              Turn your phone sideways into a virtual gamepad interface designed for casual PC gaming, emulators, and media navigation.
            </p>

            <ul class="step-inputs">
              <li>Virtual analog thumbstick with normalized axis input</li>
              <li>Virtual directional pad (D-pad)</li>
              <li>On-screen action buttons mapped to standard PC controls</li>
            </ul>

            <!-- Micro-animation for Gaming stick -->
            <div class="gesture-anim-badge" aria-label="Gaming Virtual Stick Animation">
              <svg width="36" height="36" viewBox="0 0 64 64" fill="none" class="gesture-anim" aria-hidden="true">
                <circle cx="32" cy="32" r="18" stroke="rgba(168,85,247,0.3)" stroke-width="1.5" fill="rgba(13,7,21,0.6)" />
                <line x1="32" y1="16" x2="32" y2="48" stroke="rgba(168,85,247,0.15)" stroke-width="1" />
                <line x1="16" y1="32" x2="48" y2="32" stroke="rgba(168,85,247,0.15)" stroke-width="1" />
                <circle cx="32" cy="32" r="5.5" fill="var(--color-purple-primary)" stroke="var(--color-pink-accent)" stroke-width="1.5" class="gesture-stick-dot" />
              </svg>
              <span>Analog stick orbit &bull; 4-button pad &bull; Low latency</span>
            </div>
          </div>

          <!-- Step 4: Remote Screen -->
          <div class="mode-story-step reveal" data-step="4" id="step-remote">
            <span class="display-bg-text" aria-hidden="true">05</span>
            <div class="step-header">
              <span class="badge badge-windows">Wi-Fi Only</span>
              <h3 class="step-title">Remote Screen Mode</h3>
              <p class="step-tech"><code>DirectX / WGC + H.264 Hardware Video</code></p>
            </div>

            <div class="mode-story-phone-mobile">
              <PlaceholderSlot
                assetId="remote-screen"
                label="Remote Screen"
                description="Live desktop stream up to 60 FPS"
                aspectRatio="9/16"
                deviceType="phone"
              />
            </div>

            <p class="step-desc">
              A dedicated top-level mode providing a live display stream of your PC's primary monitor directly on your phone screen, featuring direct touch interaction.
            </p>

            <ul class="step-inputs">
              <li>Live display stream of the PC's primary monitor at <strong>up to 60 FPS</strong></li>
              <li>Direct touch input mapped to absolute PC coordinates</li>
              <li>Hardware H.264 encode via Windows Media Foundation</li>
            </ul>

            <div class="mode-limitations" style="margin-top: 12px; font-size: 0.84rem; color: var(--color-text-muted);">
              <strong>Important constraints:</strong> Wi-Fi connection strictly required (Bluetooth bandwidth is insufficient). Captures primary monitor only. Blocked by Windows Secure Desktop (UAC prompts).
            </div>

            <!-- Micro-animation for Remote Screen -->
            <div class="gesture-anim-badge" aria-label="Remote Screen Stream Animation">
              <svg width="36" height="36" viewBox="0 0 64 64" fill="none" class="gesture-anim" aria-hidden="true">
                <rect x="12" y="14" width="40" height="28" rx="3" stroke="var(--color-purple-primary)" stroke-width="1.5" fill="rgba(13,7,21,0.8)" />
                <line x1="26" y1="42" x2="38" y2="42" stroke="var(--color-purple-primary)" stroke-width="1.5" />
                <line x1="32" y1="42" x2="32" y2="48" stroke="var(--color-purple-primary)" stroke-width="1.5" />
                <line x1="24" y1="48" x2="40" y2="48" stroke="var(--color-purple-primary)" stroke-width="1.5" />
                <polygon points="24,22 30,28 27,29 29,33 27,34 25,30 22,32" fill="#FFFFFF" class="gesture-gyro-cursor" />
                <path d="M40 20 A 4 4 0 0 1 44 24" stroke="#38BDF8" stroke-width="1.5" stroke-linecap="round" fill="none" class="gesture-wifi-wave-1" />
                <path d="M38 18 A 8 8 0 0 1 46 26" stroke="#38BDF8" stroke-width="1.5" stroke-linecap="round" fill="none" class="gesture-wifi-wave-2" />
                <path d="M36 16 A 12 12 0 0 1 48 28" stroke="#38BDF8" stroke-width="1.5" stroke-linecap="round" fill="none" class="gesture-wifi-wave-3" />
              </svg>
              <span>Up to 60 FPS stream &bull; Absolute coordinates &bull; Wi-Fi only</span>
            </div>
          </div>
        </div>

        <!-- Sticky Phone Crossfading Frame (Desktop Only) -->
        <div class="modes-story-sticky" aria-hidden="true">
          <div class="story-phone-stack">
            <!-- Layer 0: Touchpad -->
            <div class="story-phone-layer is-active" data-layer="0">
              <PlaceholderSlot
                assetId="touchpad-mode"
                label="Touchpad Mode"
                description="85% gesture area + 15% scroll zone"
                aspectRatio="9/16"
                deviceType="phone"
                lazy={false}
                showCaption={false}
              />
            </div>
            <!-- Layer 1: Motion -->
            <div class="story-phone-layer" data-layer="1">
              <PlaceholderSlot
                assetId="motion-mode"
                label="Motion Mode"
                description="In-air gyro steering & trigger"
                aspectRatio="9/16"
                deviceType="phone"
                lazy={true}
                showCaption={false}
              />
            </div>
            <!-- Layer 2: Touchless -->
            <div class="story-phone-layer" data-layer="2">
              <PlaceholderSlot
                assetId="touchless-mode"
                label="Touchless Mode"
                description="MediaPipe hand tracking camera"
                aspectRatio="9/16"
                deviceType="phone"
                lazy={true}
                showCaption={false}
              />
            </div>
            <!-- Layer 3: Gaming -->
            <div class="story-phone-layer" data-layer="3">
              <PlaceholderSlot
                assetId="gaming-mode"
                label="Gaming Mode"
                description="Virtual gamepad layout with D-pad & action buttons"
                aspectRatio="9/16"
                deviceType="phone"
                lazy={true}
                showCaption={false}
              />
            </div>
            <!-- Layer 4: Remote Screen -->
            <div class="story-phone-layer" data-layer="4">
              <PlaceholderSlot
                assetId="remote-screen"
                label="Remote Screen"
                description="Live desktop stream up to 60 FPS"
                aspectRatio="9/16"
                deviceType="phone"
                lazy={true}
                showCaption={false}
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Full-Bleed Gradient Statement Band -->
  <section class="gradient-statement-band" aria-label="Product Statement">
    <div class="container">
      <p class="statement-text">
        Turn your everyday Android phone into a <span class="gradient-text">precision wireless controller</span> for Windows 10 & 11.
      </p>
    </div>
  </section>

  <!-- Quick Controls Marquee & Utilities Section -->
  <section class="utilities-section">
    <div class="container">
      <div class="section-header reveal">
        <span class="eyebrow"><span class="eyebrow-index">02</span> Companion Tools</span>
        <h2 class="section-title">Utilities & Instant Shortcuts</h2>
        <p class="section-desc">
          Utility controls live in a collapsible bar at the top of your mobile screen, keeping essential PC actions at your fingertips without switching modes.
        </p>
      </div>

      <!-- Horizontal Chip Marquee Strip -->
      <div class="marquee-container pause-offscreen reveal" aria-label="Windows Utility Shortcuts Marquee">
        <div class="marquee-track">
          <div class="control-chip"><span>Volume</span> <code>Vol +/-</code></div>
          <div class="control-chip"><span>Mute</span> <code>Vol Mute</code></div>
          <div class="control-chip"><span>Brightness</span> <code>WMI / DDC/CI</code></div>
          <div class="control-chip"><span>Task View</span> <code>Win+Tab</code></div>
          <div class="control-chip"><span>Taskbar Apps</span> <code>Win+T</code></div>
          <div class="control-chip"><span>Show Desktop</span> <code>Win+D</code></div>
